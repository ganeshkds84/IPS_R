# Copy to .env and adjust. Variables already set in the shell take precedence.
# All IPS_R_* variables are optional.

# Deployment context (development | ci | production)
IPS_R_ENV=development

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL; format: console | json
IPS_R_LOG_LEVEL=INFO
IPS_R_LOG_FORMAT=console

# Global random seed (overrides configs/seed/default.yaml)
IPS_R_SEED=42

# Project root and config dir (auto-detected when unset)
# IPS_R_ROOT=/path/to/IPS_R
# IPS_R_CONFIG_DIR=/path/to/IPS_R/configs

# Redirect large working directories, e.g. to a scratch disk
# IPS_R_DATA_DIR=/scratch/ips_r/data
# IPS_R_CACHE_DIR=/scratch/ips_r/cache
# IPS_R_MODELS_DIR=/scratch/ips_r/models
# IPS_R_OUTPUT_DIR=/scratch/ips_r/outputs

# Third-party caches (recommended to keep inside cache/)
# HF_HOME=./cache/huggingface
# TORCH_HOME=./cache/torch

# Secrets - never commit real values
# HF_TOKEN=
# WANDB_API_KEY=
